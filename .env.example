# Copy to .env (docker-compose.dev.yml reads it as its env file).
# Every value marked REQUIRED fails the stack configuration when empty — the
# point is that no committed working credential is inherited by a deployment
# that forgets to override it. Replace each CHANGEME.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=tortoise_test
POSTGRES_HOST=
POSTGRES_PORT=5434
# Host port published by docker-compose.dev.yml (postgres-ext).
# Leave POSTGRES_HOST empty for a unix-socket connection.

# Redis (docker-compose.dev.yml redis-ext; only used when running the
# optional redis extra / RedisCache against the container)
REDIS_HOST=localhost
REDIS_PORT=6381
# REQUIRED: redis-ext refuses to start without it, and compose fails
# configuration when it is empty. The live cache tests read the same variable,
# so run them with:
#   uv run --env-file .env --extra redis pytest tests/ -q
REDIS_PASSWORD=CHANGEME
