POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tortoise_test
POSTGRES_HOST=
POSTGRES_PORT=5434
# Host port published by docker-compose.dev.yml (postgres-ext).
# Leave POSTGRES_HOST empty for a unix-socket connection.

# Redis (docker-compose.dev.yml redis-ext; only used when running the
# optional redis extra / RedisCache against the container)
REDIS_HOST=localhost
REDIS_PORT=6381
