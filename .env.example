POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tortoise_test
POSTGRES_HOST=
POSTGRES_PORT=5434
# Host port published by docker-compose.dev.yml (postgres-ext).
# Leave POSTGRES_HOST empty for a unix-socket connection.

# Redis (docker-compose.dev.yml redis-ext; only used when running the
# optional redis extra / RedisCache against the container)
REDIS_HOST=localhost
REDIS_PORT=6381
# Mandatory: redis-ext refuses to start without it, and compose fails
# configuration when it is empty. Use a throwaway dev value — it protects the
# container, not anything of yours. The live cache tests read the same variable,
# so run them with:
#   uv run --env-file .env --extra redis pytest tests/ -q
REDIS_PASSWORD=dev-only-change-me
